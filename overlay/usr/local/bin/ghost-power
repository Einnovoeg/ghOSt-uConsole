#!/usr/bin/env bash
# =============================================================================
# ghOSt-uConsole CPU power profile manager
# Dynamic governor and frequency selection for Raspberry Pi CM4/CM5 systems.
# =============================================================================
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

PROFILE_STATE="/var/lib/ghost/power_profile"

log()     { echo -e "${GREEN}[power]${NC} $*"; }
warn()    { echo -e "${YELLOW}[power]${NC} $*"; }
section() { echo -e "\n${CYAN}${BOLD}$*${NC}"; }

cpu_policy_paths() {
    find /sys/devices/system/cpu -path '*/cpufreq' -type d 2>/dev/null | sort
}

read_sysfs() {
    local path="$1"
    [[ -r "$path" ]] && cat "$path" || true
}

available_freqs() {
    local raw path
    path="/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies"
    raw="$(read_sysfs "$path")"
    if [[ -n "$raw" ]]; then
        tr ' ' '\n' <<<"$raw" | awk 'NF' | sort -n
        return 0
    fi
    read_sysfs "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq"
    read_sysfs "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"
}

lowest_freq() {
    available_freqs | head -n 1
}

highest_freq() {
    available_freqs | tail -n 1
}

pick_freq_at_or_below() {
    local target="$1" candidate=""
    while read -r freq; do
        [[ -z "$freq" ]] && continue
        if (( freq <= target )); then
            candidate="$freq"
        fi
    done < <(available_freqs)

    if [[ -n "$candidate" ]]; then
        echo "$candidate"
    else
        lowest_freq
    fi
}

set_governor() {
    local governor="$1" path
    for path in $(cpu_policy_paths); do
        echo "$governor" > "$path/scaling_governor" 2>/dev/null || true
    done
}

set_min_freq() {
    local freq="$1" path
    [[ -n "$freq" ]] || return 0
    for path in $(cpu_policy_paths); do
        echo "$freq" > "$path/scaling_min_freq" 2>/dev/null || true
    done
}

set_max_freq() {
    local freq="$1" path
    [[ -n "$freq" ]] || return 0
    for path in $(cpu_policy_paths); do
        echo "$freq" > "$path/scaling_max_freq" 2>/dev/null || true
    done
}

set_io_scheduler() {
    local sched="$1" queue
    for queue in /sys/block/mmcblk*/queue/scheduler; do
        echo "$sched" > "$queue" 2>/dev/null || true
    done
}

save_profile() {
    mkdir -p "$(dirname "$PROFILE_STATE")"
    echo "$1" > "$PROFILE_STATE"
}

notify_profile() {
    local title="$1"
    notify-send -u low -t 2500 "ghOSt Power" "$title" --app-name="ghOSt" 2>/dev/null || true
}

profile_performance() {
    local min max
    max="$(highest_freq)"
    min="$(pick_freq_at_or_below 1800000)"
    section "Performance mode"
    set_governor "performance"
    set_max_freq "$max"
    set_min_freq "$min"
    set_io_scheduler "none"
    save_profile "performance"
    notify_profile "Performance"
    log "Pinned CPU for maximum throughput."
}

profile_balanced() {
    section "Balanced mode"
    set_governor "schedutil"
    set_max_freq "$(highest_freq)"
    set_min_freq "$(lowest_freq)"
    set_io_scheduler "mq-deadline"
    save_profile "balanced"
    notify_profile "Balanced"
    log "Adaptive scaling enabled."
}

profile_powersave() {
    local max
    max="$(pick_freq_at_or_below 1200000)"
    section "Power-save mode"
    set_governor "powersave"
    set_max_freq "$max"
    set_min_freq "$(lowest_freq)"
    set_io_scheduler "mq-deadline"
    brightnessctl set 35% >/dev/null 2>&1 || true
    save_profile "powersave"
    notify_profile "Power save"
    log "Reduced CPU ceiling for longer battery life."
}

profile_gaming() {
    local min max
    max="$(highest_freq)"
    min="$(pick_freq_at_or_below 1500000)"
    section "Gaming mode"
    set_governor "performance"
    set_max_freq "$max"
    set_min_freq "$min"
    set_io_scheduler "none"
    save_profile "gaming"
    notify_profile "Gaming"
    log "Higher minimum clocks for interactive workloads."
}

profile_stealth() {
    local max
    max="$(pick_freq_at_or_below 1000000)"
    section "Stealth mode"
    set_governor "powersave"
    set_max_freq "$max"
    set_min_freq "$(lowest_freq)"
    set_io_scheduler "mq-deadline"
    brightnessctl set 20% >/dev/null 2>&1 || true
    for svc in syncthing@ghost kismet bettercap; do
        systemctl stop "$svc" 2>/dev/null || true
    done
    save_profile "stealth"
    log "Quiet profile applied with reduced brightness and clocks."
}

profile_sdr() {
    local fixed
    fixed="$(pick_freq_at_or_below 1800000)"
    section "SDR mode"
    set_governor "performance"
    set_max_freq "$fixed"
    set_min_freq "$fixed"
    set_io_scheduler "mq-deadline"
    save_profile "sdr"
    notify_profile "SDR"
    log "Fixed clocks selected to reduce SDR timing jitter."
}

show_status() {
    local governor min max active
    governor="$(read_sysfs /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
    min="$(read_sysfs /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq)"
    max="$(read_sysfs /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq)"
    active="$(read_sysfs "$PROFILE_STATE")"

    section "ghOSt-uConsole power status"
    echo " Active profile: ${active:-unknown}"
    echo " Governor:       ${governor:-unknown}"
    echo " Min frequency:  ${min:-unknown}"
    echo " Max frequency:  ${max:-unknown}"
    echo " Available:      $(available_freqs | tr '\n' ' ')"
    echo ""
}

show_menu() {
    echo -e "${CYAN}${BOLD} ghOSt-uConsole power profiles${NC}"
    echo ""
    echo " 1) performance"
    echo " 2) balanced"
    echo " 3) powersave"
    echo " 4) gaming"
    echo " 5) stealth"
    echo " 6) sdr"
    echo " 7) status"
    echo ""
    read -r -p "Select profile: " choice
    case "$choice" in
        1) profile_performance ;;
        2) profile_balanced ;;
        3) profile_powersave ;;
        4) profile_gaming ;;
        5) profile_stealth ;;
        6) profile_sdr ;;
        7) show_status ;;
        *) warn "Invalid selection" ;;
    esac
}

case "${1:-menu}" in
    performance) profile_performance ;;
    balanced) profile_balanced ;;
    powersave) profile_powersave ;;
    gaming) profile_gaming ;;
    stealth) profile_stealth ;;
    sdr) profile_sdr ;;
    status) show_status ;;
    menu) show_menu ;;
    *) warn "Usage: ghost-power [performance|balanced|powersave|gaming|stealth|sdr|status]" ;;
esac
